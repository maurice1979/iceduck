# Configure for Floci
AWS_ACCESS_KEY_ID=floci
AWS_SECRET_ACCESS_KEY=floci
AWS_DEFAULT_REGION=eu-west-1

# Set the endpoint URL (use --endpoint-url for every command)
AWS_ENDPOINT_URL=http://localhost:4566

# How silver/gold Iceberg tables get written: duckdb_native | pyiceberg
# Resolved to pyiceberg by the spike in docs/plans/0003-iceberg-glue-spike.md —
# duckdb_native isn't usable yet (dbt-duckdb 1.11.0 has no catalogs.yml v2 support).
# See ADR-0005.
ICEBERG_WRITE_MODE=pyiceberg